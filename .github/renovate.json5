{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended"],

  // Dependabot already owns pip, docker, github-actions and pre-commit here.
  // Renovate is enabled for exactly one thing Dependabot cannot see: the chart
  // versions living in `targetRevision` inside the ArgoCD Application
  // manifests. Dependabot only ever reads `dependencies:` out of a Chart.yaml,
  // so reaching those versions with it would mean wrapping every upstream
  // chart in a local umbrella chart first. Any manager enabled beyond argocd
  // would race Dependabot for files it is already updating.
  //
  // custom.regex is the second exception: the Talos and Kubernetes pins in
  // talos/common.sh are shell variables, which no Dependabot ecosystem reads.
  enabledManagers: ["argocd", "custom.regex"],

  argocd: {
    // The argocd manager matches no files at all by default - without this it
    // silently does nothing.
    //
    // The leading `[^_]` skips underscore-prefixed templates. Helm does not
    // render those, so `_trivy-operator.yaml` is a disabled Application (it was
    // renamed that way in 158c4ec, "Remove trivy"), and bumping the chart of
    // something that never deploys is pure PR noise. Its pin stays where it is
    // until the file is renamed back.
    managerFilePatterns: [
      "/^kubernetes/charts/app-of-apps/templates/[^_].+\\.yaml$/",
    ],
  },

  // Only the two version pins. TALOS_CONFIG_SCHEMA in the same file is held
  // back on purpose (see its comment) and must not be matched.
  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: ["/^talos/common\\.sh$/"],
      matchStrings: ['\\nTALOS_VERSION="(?<currentValue>[^"]+)"'],
      datasourceTemplate: "github-releases",
      depNameTemplate: "siderolabs/talos",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^talos/common\\.sh$/"],
      matchStrings: ['\\nKUBERNETES_VERSION="(?<currentValue>[^"]+)"'],
      datasourceTemplate: "github-releases",
      depNameTemplate: "kubernetes/kubernetes",
      // Tags are `v1.36.3`; the pin is `1.36.3`, as talosctl wants it.
      extractVersionTemplate: "^v(?<version>.+)$",
    },
  ],

  // The point of the exercise. `targetRevision: 40.*.*` resolves to whatever
  // upstream published most recently, so what is deployed can change without a
  // commit and the repo stops being the record of what is running. Pinning
  // rewrites the wildcard to the exact version it resolves to today, and every
  // move after that arrives as a reviewable PR.
  rangeStrategy: "pin",

  // Mirrors the `cooldown: default-days: 7` the Dependabot entries carry: long
  // enough that an upstream release pulled shortly after publication is not
  // already merged here.
  minimumReleaseAge: "7 days",

  // No `schedule` here on purpose. This repo runs Renovate from a workflow, so
  // the cron in renovate.yaml is already the schedule; a second one here would
  // be a silent gate that has to be kept in sync with it. Set one here if
  // Renovate ever moves to the hosted GitHub App instead.

  // A chart major is where the breaking changes are, and reviewing one next to
  // three patch bumps is how it gets skimmed. Patches and minors group into a
  // single PR; majors each get their own.
  packageRules: [
    {
      matchManagers: ["argocd"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "argocd charts",
    },
    {
      matchManagers: ["argocd"],
      matchUpdateTypes: ["major"],
      // Majors in this repo have needed values changes (traefik 40 -> 41
      // renamed the whole `logs:` block). Keep the upgrade notes in the PR.
      commitMessagePrefix: "bump(major):",
    },
    {
      // Talos and Kubernetes both move one minor at a time, through the
      // latest patch of each (docs/talos.md#upgrading), and upgrade.sh refuses
      // anything else. Without these Renovate offers one PR straight to the
      // newest release; with them a patch and each next minor arrive as
      // separate PRs, to be merged and run in order.
      matchDepNames: ["siderolabs/talos", "kubernetes/kubernetes"],
      separateMinorPatch: true,
      separateMultipleMinor: true,
      prBodyNotes: [
        "Merging only moves the pin. The nodes stay where they are until `./talos/upgrade.sh` is run from `main`, Talos before Kubernetes: see [Upgrading](https://github.com/theadzik/homelab/blob/main/docs/talos.md#upgrading). For a new minor, work through *Before bumping a pin* there first.",
      ],
    },
  ],
}
